{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["plan_key"],
    "additionalProperties": false,
    "properties": {
      "plan_key": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "stripe_price_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "price_cents": {
        "type": "integer",
        "minimum": 0
      },
      "currency": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3
      },
      "rate_limit_rpm": {
        "type": "integer",
        "minimum": 1
      },
      "features": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "monthly_quota": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
  